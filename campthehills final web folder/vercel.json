{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/tour",    "destination": "/shows", "permanent": false },
    { "source": "/dates",   "destination": "/shows", "permanent": false },
    { "source": "/live",    "destination": "/shows", "permanent": false },
    { "source": "/clips",   "destination": "/watch", "permanent": false },
    { "source": "/videos",  "destination": "/watch", "permanent": false },
    { "source": "/music",   "destination": "/#listen",  "permanent": false },
    { "source": "/credits", "destination": "/#credits", "permanent": false },
    { "source": "/contact", "destination": "/#contact", "permanent": false },
    { "source": "/press",   "destination": "/assets/campthehills-press-kit.zip", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
